# Stripe TEST MODE only. Use sk_test_ / pk_test_ keys.
# Never use live keys. Never commit .env.local.
# Leave Stripe keys empty to run the app without processing payments.

STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# Optional. Used for metadata, sitemap, and Open Graph URLs.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# PostgreSQL. Required to persist transactions and webhook events.
# Do not commit real credentials.
DATABASE_URL=postgres://USER:PASSWORD@localhost:5432/northline

# Optional. Used only by PostgreSQL integration tests.
# TEST_DATABASE_URL=postgres://USER:PASSWORD@localhost:5432/northline_test

# Optional. Public API rate limits (PostgreSQL-backed). Defaults are shown.
# RATE_LIMIT_CREATE_INTENT_MAX=10
# RATE_LIMIT_CREATE_INTENT_WINDOW_MS=60000
# RATE_LIMIT_CREATE_INTENT_IDENTITY_MAX=6
# RATE_LIMIT_CREATE_INTENT_IDENTITY_WINDOW_MS=60000
# RATE_LIMIT_WEBHOOK_UNSIGNED_MAX=60
# RATE_LIMIT_WEBHOOK_UNSIGNED_WINDOW_MS=60000

